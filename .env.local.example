# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.
# These are the Next.js / Vercel side variables from the architecture
# document, section 18. Supabase Edge Function secrets are configured
# separately in the Supabase project, not here.

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key, RLS-scoped (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Akahu app id used by the My Akahu Connect widget (public)
NEXT_PUBLIC_AKAHU_APP_ID=

# Base URL of this app, used for OAuth and invite redirects (public)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret Edge Functions send when calling /api/revalidate (server-only)
REVALIDATE_SECRET=
